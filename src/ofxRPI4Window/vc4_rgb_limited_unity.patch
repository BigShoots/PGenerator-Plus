PGenerator issue 74 — RGB Limited unity-CSC kernel add-on (RQ3V1)
===================================================================

Base requirement: applied ON TOP OF the full drm_vc4.patch in the
5.10.89+-7l (iMG/Biasi) kernel build environment, i.e. a tree where
vc4_hdmi.c already contains vc4_hdmi_is_full_range_rgb() and the
conn_state->broadcast_rgb plumbing.  Apply from the kernel root:

    patch -p1 --forward < vc4_rgb_limited_unity.patch

Semantics added: connector property "rgb quant range" value 3 means
"Limited signalling, unity CSC".  Values 0/1/2 (Automatic/Limited/
Full) behave bit-identically to the unpatched kernel, so a kernel
built with this add-on stays drop-in compatible.

Two adaptation points live in the iMG base and are NOT visible in the
hunks below; verify them in the build tree before compiling:

  1. Enum ordering.  The helper below assumes LIMITED and FULL occupy
     two of {1,2} so that raw value 3 is a free enum slot:

         grep -n 'DRM_HDMI_BROADCAST_RGB' include/drm/drm_connector.h

     Expected: AUTO=0 with LIMITED/FULL taking 1 and 2 in any order
     (the shipped property must already map 1=Limited, 2=Full to
     match the renderer conf).  If 3 is not free, stop and re-map.

  2. Property acceptance.  "rgb quant range" must accept value 3.
     Locate the creation site:

         grep -rn '"rgb quant range"' drivers/gpu/drm

     For a drm_property_create_range(..., 0, 2) site raise the bound
     to 3; for a drm_property_create_enum site append an entry such
     as { 3, "Limited (unity CSC)" }.  The driver-side set-property
     hook must pass the raw value into conn_state->broadcast_rgb
     (no clamping) as it does today.

Verification after building:

    modinfo -F srcversion drivers/gpu/drm/vc4/vc4.ko   # must contain RQ3V1
    # runtime, with the property set to 3 (modetest or the renderer):
    #   AVI infoframe still signals Limited (analyzer or TV OSD),
    #   framebuffer code 0x20 reaches the wire as 0x20 (no 0x1b80
    #   squash); stock value-1 behaviour keeps the old compress path.

The renderer side of this contract is wireRgbQuantRange()/
rgbLimitedPassthrough() in src/ofxRPI4Window (marker grep "RQ3V1"),
which only draws wire codes itself once the marker is present.
Value 3 is never sent to unpatched kernels.

--- a/drivers/gpu/drm/vc4/vc4_hdmi.c
+++ b/drivers/gpu/drm/vc4/vc4_hdmi.c
@@ -5,6 +5,28 @@
 	return (mode->clock * 1000) > HDMI_14_MAX_TMDS_CLK;
 }
 
+/*
+ * PGenerator issue 74: extended "rgb quant range" value 3.
+ *
+ * The renderer needs Limited signalling (AVI infoframe and CEA wire
+ * levels) without the 0x1b80/0x0400 compress matrix: squashing 256
+ * full-range codes through that fixed-point matrix is lossy, so for
+ * its own patterns the generator draws the Limited wire codes itself
+ * and asks the CSC to stay at unity.  Value 3 behaves exactly like
+ * LIMITED everywhere except the CSC coefficient selection.
+ *
+ * LIMITED and FULL occupy two of {1,2} in this tree's
+ * enum drm_hdmi_broadcast_rgb, so 3 is free; see the commit message
+ * for the build-time checks.
+ */
+#define DRM_HDMI_BROADCAST_RGB_LIMITED_UNITY	3
+
+static bool vc4_hdmi_rgb_limited_unity(const struct drm_connector_state *conn_state)
+{
+	return conn_state &&
+	       conn_state->broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED_UNITY;
+}
+
 static bool vc4_hdmi_is_full_range_rgb(struct vc4_hdmi *vc4_hdmi,
 				       const struct drm_connector_state *conn_state,
 				       const struct drm_display_mode *mode)
@@ -16,7 +38,8 @@
 	if (broadcast_rgb == DRM_HDMI_BROADCAST_RGB_FULL)
 		return true;
 
-	if (broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED)
+	if (broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED ||
+	    broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED_UNITY)
 		return false;
 
 	return !vc4_encoder->hdmi_monitor ||
@@ -42,7 +65,8 @@
 	case DRM_COLOR_FORMAT_RGB444:
 		if_xbar = 0x354021;
 
-		if (!vc4_hdmi_is_full_range_rgb(vc4_hdmi, conn_state, mode))
+		if (!vc4_hdmi_is_full_range_rgb(vc4_hdmi, conn_state, mode) &&
+		    !vc4_hdmi_rgb_limited_unity(conn_state))
 			vc5_hdmi_set_csc_coeffs(vc4_hdmi, vc5_hdmi_csc_full_rgb_to_limited_rgb);
 		else
 			vc5_hdmi_set_csc_coeffs(vc4_hdmi, vc5_hdmi_csc_full_rgb_unity);

--- a/scripts/mod/modpost.c
+++ b/scripts/mod/modpost.c
@@ -1,8 +1,14 @@
 static void add_srcversion(struct buffer *b, struct module *mod)
 {
 	if (mod->srcversion[0]) {
+		/* PGenerator: stamp builds of vc4.ko that carry the RGB
+		 * Limited unity-CSC hunk; the renderer greps the module's
+		 * srcversion for RQ3V1 before switching to that path.
+		 */
+		const char *marker = strcmp(mod->name, "vc4") ? "" : "RQ3V1-";
+
 		buf_printf(b, "\n");
-		buf_printf(b, "MODULE_INFO(srcversion, \"%s\");\n",
-			   mod->srcversion);
+		buf_printf(b, "MODULE_INFO(srcversion, \"%s%s\");\n",
+			   marker, mod->srcversion);
 	}
 }

