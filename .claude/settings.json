{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh release create *)",
      "Bash(gh release upload *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(tools/release-ota.sh *)",
      "Bash(./tools/release-ota.sh *)",
      "Bash(bash tools/release-ota.sh *)",
      "Bash(tools/release-action.sh *)",
      "Bash(./tools/release-action.sh *)",
      "Bash(bash tools/release-action.sh *)",
      "Bash(.claude/skills/pi/scripts/pgen-pi reboot *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pi_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pi_stop.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify_stop.py\" || exit 1",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
