#!/usr/bin/expect -f
# Password SSH/scp to the PGenerator+ Pi (key auth is not set up). Called by
# pgen-pi, which puts the password into PGPASS; not for direct use.
#   PGPASS=... pi.exp ssh 'command'
#   PGPASS=... pi.exp scp LOCAL... REMOTE_PATH
#   PGPASS=... pi.exp fetch REMOTE_PATH... LOCAL
# Host: $PI_HOST (default 192.168.1.235). Needs the sandbox disabled for LAN
# access. PI_TIMEOUT (default 600): seconds WITHOUT output before giving up
# (exit 124); every output line starts the count again, so a sweep that
# prints a line per code may run longer than that.
set timeout 600
if {[info exists env(PI_TIMEOUT)]} {
  if {[string is integer -strict $env(PI_TIMEOUT)] && $env(PI_TIMEOUT) > 0} {
    set timeout $env(PI_TIMEOUT)
  } else {
    puts stderr "pi.exp: PI_TIMEOUT '$env(PI_TIMEOUT)' is no number of seconds, using 600"
  }
}
set mode [lindex $argv 0]
set host [expr {[info exists env(PI_HOST)] ? $env(PI_HOST) : "192.168.1.235"}]
set kh "$env(TMPDIR)/pgen-known_hosts"
set opts [list -F /dev/null -o UserKnownHostsFile=$kh -o StrictHostKeyChecking=accept-new -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive]
if {$mode eq "ssh"} {
  eval spawn -noecho ssh $opts root@$host [list [lindex $argv 1]]
} elseif {$mode eq "fetch"} {
  # fetch REMOTE_PATH... LOCAL: copy from the Pi
  set dst [lindex $argv end]
  set srcs {}
  foreach s [lrange $argv 1 end-1] { lappend srcs root@$host:$s }
  eval spawn -noecho scp $opts $srcs [list $dst]
} else {
  set dst [lindex $argv end]
  set srcs [lrange $argv 1 end-1]
  eval spawn -noecho scp $opts $srcs [list root@$host:$dst]
}
# The password goes out once, at the first prompt. A second prompt before
# the command printed anything (only empty lines or ssh's own "Permission
# denied, please try again." in between) means refused: exit 5, the same password is not typed again.
# A "password:" after real output is the command's own and gets nothing.
# Whole lines are taken first, so a prompt is only what ends the buffer.
set sent 0
set real 0
expect {
  -re "^(\[^\n\]*)\n" {
    set l [string trim $expect_out(1,string)]
    if {$sent && $l ne $env(PGPASS) && ![regexp {^$|^Permission denied(, please try again\.| \()} $l]} { set real 1 }
    exp_continue
  }
  -re "assword:" {
    if {!$sent} { send -- "$env(PGPASS)\r"; set sent 1 } elseif {!$real} {
      puts "\npi.exp: password refused by $host"; catch {close}; catch wait; exit 5
    }
    exp_continue
  }
  timeout { puts "\npi.exp: no output for $timeout s, giving up (PI_TIMEOUT)"; catch {close}; catch wait; exit 124 }
  eof
}
# wait: pid spawn_id os_error value, then CHILDKILLED signal ... when a signal
# ended ssh (value is 0 then: never report that as success).
if {[catch wait r] || [lindex $r 2] != 0} { puts "\npi.exp: lost ssh ($r)"; exit 1 }
if {[lindex $r 4] eq "CHILDKILLED"} { puts "\npi.exp: ssh killed by [lindex $r 5]"; exit 1 }
exit [lindex $r 3]
